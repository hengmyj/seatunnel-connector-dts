#
# DTS Source -> Console (template — copy to dts-to-console.conf with real credentials)
#

env {
  job.mode = "STREAMING"
  checkpoint.interval = 10000
  parallelism = 1
}

source {
  Dts {
    broker-url = "dts-ap-southeast-1.aliyuncs.com:18001"
    topic = "your_dts_topic"
    sid = "your_sid"
    user = "your_user"
    password = "your_password"
    checkpoint = "0"
    force-checkpoint = false
    max-poll-records = 500
    queue-capacity = 10000
    dry-run = false
    # 表白名单，格式 db.table；留空或不配置表示订阅全部表
    # table-list = ["mydb.orders", "mydb.users"]
    # table-list = "mydb.orders,mydb.users"
  }
}

sink {
  Console {}
}
